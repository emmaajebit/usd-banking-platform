# Copy to .env for local development. These defaults line up with docker-compose.

# --- Service identity ---
SERVICE_NAME=service-template
ENVIRONMENT=development
VERSION=0.1.0

# --- HTTP ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# --- gRPC (enable per service) ---
GRPC_ENABLED=false
GRPC_PORT=9090

# --- PostgreSQL (single shared database, tables prefixed per service) ---
POSTGRES_ENABLED=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=banking
POSTGRES_PASSWORD=banking
POSTGRES_DB=banking
POSTGRES_SSLMODE=disable

# --- Redis ---
REDIS_ENABLED=false
REDIS_ADDR=localhost:6379

# --- Kafka ---
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=

# --- Auth / JWT (shared secret across services) ---
JWT_SECRET=dev-secret-change-me
JWT_ISSUER=banking-platform
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Object storage (S3 / MinIO) — used by document-service ---
S3_ENABLED=false
AWS_REGION=us-east-1
S3_BUCKET=banking-documents
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=false

# --- OpenTelemetry ---
# Disable locally unless you run the full observability stack (Phase 14).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACE_SAMPLE_RATIO=1.0

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=console
